# Pick one. You can also set this in the UI (Settings), which takes precedence.

# 1) Anthropic directly
ANTHROPIC_API_KEY=sk-ant-...

# 2) A LiteLLM proxy in front of Anthropic (its Anthropic-compatible /v1/messages endpoint)
# LITELLM_BASE_URL=https://your-litellm.example.com
# LITELLM_API_KEY=sk-your-litellm-key

# Default model for runs (optional)
# LAB_MODEL=claude-opus-5-5
